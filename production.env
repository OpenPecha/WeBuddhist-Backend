# Production Environment Variables for Memory Optimization

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Uvicorn Settings
UVICORN_WORKERS=1
UVICORN_MAX_REQUESTS=1000
UVICORN_MAX_REQUESTS_JITTER=50

# Logging
LOG_LEVEL=INFO

# Memory Management
PYTHONMALLOC=malloc
PYTHONMALLOCSTATS=1

# Cache Settings (reduced from defaults)
CACHE_DEFAULT_TIMEOUT=300  # 5 minutes instead of 30
CACHE_TEXT_TIMEOUT=600     # 10 minutes instead of 30
CACHE_COLLECTION_TIMEOUT=600
CACHE_USER_TIMEOUT=300     # 5 minutes instead of 15
CACHE_TOPIC_TIMEOUT=600    # 10 minutes instead of 30
CACHE_SHEET_TIMEOUT=60     # Keep at 1 minute

# Reduce image expiration to save memory
IMAGE_EXPIRATION_IN_SEC=1800  # 30 minutes instead of 1 hour

# API Rate Limiting
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=50